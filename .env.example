# === Unilog Product Intelligence — environment configuration ===

# mock  = deterministic offline mode, no external API calls (default, used in CI/tests)
# claude = use Anthropic Claude for the reasoning steps that need it
APP_MODE=mock

# Required only when APP_MODE=claude
ANTHROPIC_API_KEY=

# Model used for the "strong" reasoning tier (ambiguous classification, entity
# adjudication, conflict resolution, description generation grounding checks)
CLAUDE_MODEL=claude-sonnet-4-5

# Optional: cheaper/faster tier for high-volume, low-ambiguity calls.
# Falls back to CLAUDE_MODEL if unset.
CLAUDE_MODEL_FAST=claude-haiku-4-5

# API server
API_HOST=0.0.0.0
API_PORT=8000

# Where run artifacts (caches, reports) are written
DATA_DIR=./data
REPORTS_DIR=./reports

# Confidence threshold below which a record is routed to human review (0-1)
REVIEW_CONFIDENCE_THRESHOLD=0.72
